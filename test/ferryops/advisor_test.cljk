(ns ferryops.advisor-test
  "Unit tests of `ferryops.advisor` proposal generation."
  (:require [kotoba.test :refer [deftest is testing]]
            [ferryops.advisor :as adv]
            [ferryops.store :as store]))

(def db (store/seed-db))

(deftest propose-service-record-shape
  (testing "service-record proposal has correct shape and fields"
    (let [p (adv/infer db {:op :log-service-record
                           :route-id "route-1"
                           :patch {:crossings-completed 6 :passengers 214 :incident-reports 0}})]
      (is (= :log-service-record (:op p)))
      (is (= "route-1" (:route-id p)))
      (is (= :propose (:effect p)))
      (is (<= 0 (:confidence p) 1))
      (is (map? (:value p)))
      (is (contains? (:value p) :route-id)))))

(deftest propose-crossing-schedule-shape
  (testing "crossing-schedule proposal has correct shape"
    (let [p (adv/infer db {:op :schedule-crossing-operation
                           :route-id "route-2"
                           :patch {:crossing "weekend-loop" :date "2026-07-20"}})]
      (is (= :schedule-crossing-operation (:op p)))
      (is (= "route-2" (:route-id p)))
      (is (= :propose (:effect p))))))

(deftest propose-maintenance-order-shape
  (testing "maintenance-order proposal has correct shape"
    (let [p (adv/infer db {:op :coordinate-maintenance-order
                           :route-id "route-1"
                           :patch {:item "engine inspection service" :estimated-cost 650.0
                                   :contractor-id "contractor-1"}})]
      (is (= :coordinate-maintenance-order (:op p)))
      (is (= :propose (:effect p)))
      (is (string? (:summary p)))
      (is (= "contractor-1" (get-in p [:value :contractor-id]))))))

(deftest propose-safety-concern-shape
  (testing "safety-concern proposal always escalates"
    (let [p (adv/infer db {:op :flag-safety-concern
                           :route-id "route-1"
                           :patch {:concern "unusual list to port during boarding"}})]
      (is (= :flag-safety-concern (:op p)))
      (is (= :propose (:effect p)))
      (is (string? (:summary p))))))

(deftest all-proposals-effect-is-always-propose
  (testing "every proposal type has :effect :propose, never direct actuation"
    (doseq [op [:log-service-record :schedule-crossing-operation :coordinate-maintenance-order
                :flag-safety-concern]]
      (let [p (adv/infer db {:op op :route-id "route-1" :patch {}})]
        (is (= :propose (:effect p))
            (str "op " op " must have :effect :propose"))))))

(deftest rationale-string-is-present
  (testing "every proposal has a rationale explaining the advisor's thinking"
    (doseq [op [:log-service-record :schedule-crossing-operation :coordinate-maintenance-order
                :flag-safety-concern]]
      (let [p (adv/infer db {:op op :route-id "route-1" :patch {}})]
        (is (string? (:rationale p))
            (str "op " op " must have a :rationale string"))))))
